{#- Site footer. The app list is generated from src/_data/apps/, so new apps appear automatically. -#}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <img class="brand-mark" src="/images/xerodonia-mark.svg" alt="" width="32" height="32">
          <span class="brand-name">{{ site.name }}</span>
        </a>
        <p>Thoughtful apps and practical AI consulting from {{ site.location }}.</p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <nav aria-label="Apps">
        <h2 class="footer-heading">Apps</h2>
        <ul>
          {%- for app in apps | sortProducts %}
          <li><a href="{{ app | productUrl }}">{{ app.name }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2 class="footer-heading">Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/consulting/">Consulting</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2 class="footer-heading">Legal</h2>
        <ul>
          <li><a href="/privacy/">Website privacy</a></li>
          <li><a href="/apps/">App privacy and support</a></li>
        </ul>
      </nav>
    </div>
    <p class="legal">© {{ site.currentYear }} {{ site.legalName }} · ABN {{ site.abn }} · {{ site.location }}</p>
    <p class="legal">Apple, the Apple logo, iPhone, iPad and Mac are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc.</p>
  </div>
</footer>
