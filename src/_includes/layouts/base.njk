{#- The outer shell of every page.
    Front matter it reads: title, description, accent, bodyClass, app (on app pages). -#}
{%- set pageTitle = title + " · " + site.name if title and title != site.name else site.name + ": thoughtful apps for iPhone, iPad and Mac" -%}
{%- set pageDescription = description or site.description -%}
{#- Link-preview image: a page's ogImage, else its app's card, else the site default (made by `npm run images`). -#}
{%- set pageImage = ogImage or ("/images/og/" + app.slug + ".jpg" if app else "/images/og/default.jpg") -%}
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ pageImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ pageTitle }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if app and app.appStoreId %}
  <meta name="apple-itunes-app" content="app-id={{ app.appStoreId }}">
  {%- endif %}

  <script type="application/ld+json">{{ { pageType: pageType, page: page, title: title, description: description, app: app, site: site, consulting: consulting } | jsonLd | safe }}</script>
  <link rel="alternate" type="text/markdown" title="{{ site.name }} for AI agents (llms.txt)" href="/llms.txt">
  {%- if pageType and pageType.startsWith("consulting") %}
  <link rel="alternate" type="application/json" title="Consulting services and prices" href="/consulting/services.json">
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} blog" href="/feed.xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/images/xerodonia-mark.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/styles/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}{% if accent %} style="--accent: {{ accent }}"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
