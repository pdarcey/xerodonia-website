---
# One page per audience in consulting.yaml, at /consulting/<slug>/
layout: layouts/base.njk
pagination:
  data: consulting.audiences
  size: 1
  alias: audience
  addAllPagesToCollections: true
permalink: "/consulting/{{ audience.slug }}/"
pageType: consulting-audience
eleventyComputed:
  title: "{{ audience.title }}"
  description: "{{ audience.lead }}"
---
{% include "partials/consulting-nav.njk" %}

<section class="hero hero--left">
  <div class="wrap">
    <p class="eyebrow">{{ audience.eyebrow }}</p>
    <h1 class="hero-title">{{ audience.title }}</h1>
    <p class="hero-lead">{{ audience.lead }}</p>
    <div class="actions">
      <a class="button button--primary" href="{{ site.calendlyUrl }}">{{ audience.cta }}</a>
      <a class="button button--secondary" href="/consulting/services/">Services and pricing</a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="concerns-title">
  <div class="wrap split">
    <div>
      <h2 id="concerns-title">{{ audience.concernsHeading }}</h2>
      <p class="split-intro">{{ audience.concernsIntro }}</p>
    </div>
    <ul class="quote-list">
      {%- for concern in audience.concerns %}
      <li>{{ concern }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section features" aria-labelledby="help-title">
  <div class="wrap">
    <header class="section-header">
      <h2 id="help-title">{{ audience.helpHeading }}</h2>
    </header>
    <ul class="feature-grid">
      {%- for item in audience.help %}
      <li class="feature"><h3>{{ item.title }}</h3><p>{{ item.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section consulting" aria-labelledby="outcomes-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow">What you get</p>
      <h2 id="outcomes-title">{{ audience.outcomesHeading }}</h2>
      <div class="actions">
        <a class="button button--primary" href="{{ site.calendlyUrl }}">{{ audience.cta }}</a>
      </div>
    </div>
    <ul class="checklist">
      {%- for outcome in audience.outcomes %}<li>{{ outcome }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="start-title">
  <div class="wrap">
    <header class="section-header">
      <h2 id="start-title">Where to start</h2>
      <p>All prices are AUD, excluding GST.</p>
    </header>
    <ul class="pricing-grid">
      {%- for service in consulting.services | pickServices(audience.services) %}
      {% include "partials/pricing-card.njk" %}
      {%- endfor %}
    </ul>
    <p class="section-more"><a class="text-link" href="/consulting/services/">All services and pricing <span aria-hidden="true">→</span></a></p>
  </div>
</section>

{% include "partials/audit-cta.njk" %}
